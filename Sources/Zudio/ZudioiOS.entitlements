<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Group shared with the ZudioShare extension, which drops incoming .zudio songs
         into it for the app to pick up. Must match SharedSongInbox.appGroupID and
         Sources/ZudioShare/ZudioShare.entitlements.

         iOS target only — the Mac target uses Zudio.entitlements and is unaffected. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.zudio.app</string>
    </array>
</dict>
</plist>
