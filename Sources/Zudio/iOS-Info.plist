<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Zudio</string>

    <!-- Custom document type: .zudio song files -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Zudio Song</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>zudio</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.zudio.song</string>
            </array>
        </dict>
    </array>

    <!-- Export the UTI so iOS knows com.zudio.song is owned by this app -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.zudio.song</string>
            <key>UTTypeDescription</key>
            <string>Zudio Song</string>
            <!-- OPAQUE ON PURPOSE, AND PAIRED WITH ZudioQuickLook. Change neither
                 without the other.

                 iOS 26 removed the "Open in Zudio" affordance on a shared song. Verified
                 not a Zudio bug: a plain .txt behaves identically, the same build works on
                 iOS 18 and on Mac, and the official App Store build failed the same way.
                 Filed as FB24777501; still broken in iOS 27.

                 What finally worked (Sept 2026) — an opaque type PLUS our own Quick Look
                 preview extension. Messages then offers "Copy to Zudio" again. Neither
                 half works alone:
                   public.plain-text + previewer -> iOS uses its own text previewer and
                                                    never consults ours
                   opaque, no previewer          -> nothing can render it; the attachment
                                                    goes completely inert
                   opaque + ZudioQuickLook       -> Zudio is the only thing that can render
                                                    a .zudio, and the handoff returns
                 Note it is the extension's PRESENCE that matters, not what it draws —
                 Messages shows the Zudio icon rather than the previewer's text view.

                 Also ruled out: MIME type declarations, public.content on its own,
                 public.data alone, Mail, AirDrop. Seven variants in total.

                 Trade-off: no inline text preview of .zudio on iPhone/iPad. macOS is
                 deliberately left text-conforming (public.json -> public.text) so Finder
                 Quick Look previews as text and Open With still offers TextEdit.

                 TESTING: iOS caches UTI and extension registrations across in-place
                 updates. Delete the app, reinstall, and send a FRESH file — Messages
                 stamps an attachment's type when SENT, so old bubbles keep old typing. -->
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>zudio</string>
                </array>
            </dict>
        </dict>
    </array>

    <!-- Lets the ZudioShare extension ask the system to launch the app after it drops a
         song into the shared App Group container. Internal plumbing only — this scheme is
         not something users are expected to type or send. See SharedSongInbox.launchURL. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.zudio.app</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>zudio</string>
            </array>
        </dict>
    </array>

    <!-- Allow .zudio files to appear in Files app and be opened in place -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- Background audio: keep AVAudioEngine running when app moves to background -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <!-- No custom encryption used — exempt from export compliance -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
