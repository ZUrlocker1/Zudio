<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Zudio</string>

    <!-- Custom document type: .zudio song files -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Zudio Song</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>zudio</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.zudio.song</string>
            </array>
        </dict>
    </array>

    <!-- Export the UTI so iOS knows com.zudio.song is owned by this app -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.zudio.song</string>
            <key>UTTypeDescription</key>
            <string>Zudio Song</string>
            <!-- Deliberately NOT text-conforming, and deliberately different from the
                 Mac plist. Do not "fix" this to match — see below.

                 On iOS 26 Messages cannot open a text attachment at all. Not a Zudio
                 problem: a plain .txt behaves identically, and the same build works on
                 iOS 18 and on Mac. Seven declaration variants were tested on clean
                 installs (app deleted and reinstalled, since iOS caches UTI registrations
                 across in-place updates, phone rebooted, freshly sent file, since Messages
                 stamps an attachment's type when SENT). None produced an Open affordance;
                 Mail and AirDrop-to-iPhone behave the same way.

                 Given that nothing opens either way, the remaining choice was cosmetic:
                 text conformance makes Messages resolve up the chain to public.plain-text
                 and label the file "Text Document" (rendering the log inline), while an
                 opaque type stops that walk and lets UTTypeDescription through, so it
                 reads "Zudio Song". We took the correct label. The cost is no inline text
                 preview of .zudio files on iPhone/iPad.

                 macOS is unaffected: Info.plist still conforms to public.json ->
                 public.text, so Finder Quick Look previews as text and Open With still
                 offers TextEdit, Xcode, Chrome and the rest, with Zudio as default. -->
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>zudio</string>
                </array>
            </dict>
        </dict>
    </array>

    <!-- Lets the ZudioShare extension ask the system to launch the app after it drops a
         song into the shared App Group container. Internal plumbing only — this scheme is
         not something users are expected to type or send. See SharedSongInbox.launchURL. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.zudio.app</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>zudio</string>
            </array>
        </dict>
    </array>

    <!-- Allow .zudio files to appear in Files app and be opened in place -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- Background audio: keep AVAudioEngine running when app moves to background -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <!-- No custom encryption used — exempt from export compliance -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
