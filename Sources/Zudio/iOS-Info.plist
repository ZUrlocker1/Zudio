<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Zudio</string>

    <!-- Custom document type: .zudio song files -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Zudio Song</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>zudio</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.zudio.song</string>
            </array>
        </dict>
    </array>

    <!-- Export the UTI so iOS knows com.zudio.song is owned by this app -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.zudio.song</string>
            <key>UTTypeDescription</key>
            <string>Zudio Song</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.plain-text</string>
                <string>public.data</string>
            </array>
            <!-- Do not add public.mime-type here without testing on iOS 18. It was tried
                 in Sept 2026 to restore the missing "Open in Zudio" chip on iOS 26 and made
                 no difference: inspection of the Messages database showed .zudio attachments
                 were already typed correctly as com.zudio.song with no MIME tag at all.
                 The chip's disappearance is an iOS 26 change, not a typing problem. -->
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>zudio</string>
                </array>
            </dict>
        </dict>
    </array>

    <!-- Allow .zudio files to appear in Files app and be opened in place -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- Background audio: keep AVAudioEngine running when app moves to background -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <!-- No custom encryption used — exempt from export compliance -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
